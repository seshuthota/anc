# Provider configuration (server-side only). Copy to .env — never commit secrets.
# fixture = deterministic CI/demo specialists (no network).
MODEL_PROVIDER=fixture
# fixture | live-strict | live-fallback
# live-strict never substitutes deterministic specialist answers.
# live-fallback must be set explicitly; substitutions are recorded on the run.
MODEL_EXECUTION_MODE=fixture
# Local persona switcher. Set false before any real multi-user deployment.
DEMO_MODE=true
# demo keeps the labeled switcher. oidc requires the OpenID settings below and ignores x-anc-principal.
AUTH_MODE=demo

# OpenID Connect. Required together before AUTH_MODE=oidc will start.
# Map IdP subject or email to a DemoCo principal id, for example {"alex@company.example":"user-ops"}.
SESSION_SECRET=
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://127.0.0.1:3000/api/auth/callback
OIDC_SUBJECT_MAP=
ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
AUDIT_ACCESS_TOKEN=
# Set true only behind HTTPS.
COOKIE_SECURE=false
# Requests per client per minute. Empty uses 120.
RATE_LIMIT_PER_MINUTE=
# Delete saved evidence and surfaces older than this many days when retention runs. Empty does not imply forever is safe.
RETENTION_DAYS=

# Optional price. Leave empty to report cost as unknown. Do not use 0.
MODEL_USD_PER_MILLION=
# Optional per-run USD ceiling. Refused while the price above is empty.
MODEL_USD_BUDGET=

# Optional external read-only system. The token stays on the server.
EXTERNAL_READ_URL=
EXTERNAL_READ_TOKEN=
EXTERNAL_READ_PRINCIPALS=
# Optional low-risk external note. Stays off unless ENABLED is exactly true and the host is allowlisted.
EXTERNAL_WRITE_ENABLED=false
EXTERNAL_WRITE_URL=
EXTERNAL_WRITE_TOKEN=
EXTERNAL_WRITE_PRINCIPALS=
EXTERNAL_WRITE_HOST_ALLOWLIST=

# Explabs OpenAI-compatible API (used when MODEL_PROVIDER=explabs)
EXPLABS_API_KEY=
EXPLABS_BASE_URL=https://api.experientiallabs.ai/v1
EXPLABS_MODEL=gpt-oss-120b

# Optional SpaceXAI / generic OpenAI-compatible fallbacks
MODEL_ID=gpt-oss-120b
XAI_API_KEY=
MODEL_API_KEY=

# Local persistence
COMPANY_DB_PATH=./data/company.sqlite
RUNTIME_DB_PATH=./data/runtime.sqlite
DATASET_VERSION=sync-regression-v1

# Fixed demo clock; set to an ISO-8601 timestamp
DEMO_CLOCK=2026-09-20T08:00:00.000Z
DEMO_TIMEZONE=UTC

# Runtime budgets
MAX_INVESTIGATION_ROUNDS=8
MAX_TOOL_CALLS=6
MAX_RUNTIME_MS=120000
MAX_MODEL_TOKENS=24000

# Local services
AGENT_HOST=127.0.0.1
AGENT_PORT=4100
WEB_HOST=127.0.0.1
WEB_PORT=3000
NEXT_PUBLIC_AGENT_URL=http://127.0.0.1:4100
